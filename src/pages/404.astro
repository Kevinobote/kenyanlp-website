---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found - KenyaNLP">
  <section class="py-32 px-8 max-w-[600px] mx-auto text-center">
    <p class="font-[family-name:var(--font-family-heading)] text-6xl text-green-600 mb-4">404</p>
    <h1 class="text-2xl font-semibold mb-4">Page not found</h1>
    <p class="text-gray-600 font-light mb-8">The page you're looking for doesn't exist or has been moved.</p>
    <div class="flex gap-4 justify-center flex-wrap">
      <a href="/" class="bg-green-600 text-white px-7 py-3.5 rounded-full text-[15px] font-medium hover:bg-green-800 transition-colors no-underline">Back to home</a>
      <a href="/projects" class="border border-black/18 px-7 py-3.5 rounded-full text-[15px] hover:bg-gray-50 transition-colors no-underline text-gray-900">View projects</a>
    </div>
  </section>
</Base>
