---
interface Props {
  current: string;
}
const { current } = Astro.props;
---
<nav aria-label="Breadcrumb" class="max-w-[1060px] mx-auto px-8 pt-6">
  <ol class="flex items-center gap-1.5 text-[12px] text-gray-400 list-none">
    <li><a href="/" class="no-underline hover:text-gray-900 transition-colors">Home</a></li>
    <li class="select-none">/</li>
    <li class="text-gray-600 font-medium" aria-current="page">{current}</li>
  </ol>
</nav>
