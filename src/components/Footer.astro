---
const links = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/team', label: 'Team' },
  { href: '/contact', label: 'Contact' },
];
---
<footer class="border-t border-black/10 max-w-[1060px] mx-auto px-8 py-10">
  <div class="flex flex-wrap justify-between items-start gap-8">
    <!-- Left: Logo + tagline -->
    <div>
      <img src="/logo-light.png" alt="KenyaNLP" class="h-14 mb-2" />
      <p class="text-[13px] text-gray-400">A Masakhane-affiliated initiative for Kenyan language technology</p>
    </div>

    <!-- Right: Nav + Social -->
    <div class="flex flex-col items-end gap-4">
      <nav class="flex gap-6" aria-label="Footer navigation">
        {links.map(link => (
          <a href={link.href} class="text-[13px] text-gray-400 no-underline hover:text-gray-900 transition-colors">{link.label}</a>
        ))}
      </nav>
      <div class="flex items-center gap-4">
        <a href="https://www.linkedin.com/company/kenya-nlp/" target="_blank" rel="noopener" aria-label="KenyaNLP on LinkedIn" class="flex items-center gap-1.5 text-gray-400 hover:text-green-600 transition-colors no-underline text-[13px]">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
        <a href="mailto:info@kenyanlp.org" class="text-[13px] text-gray-400 no-underline hover:text-green-600 transition-colors">info@kenyanlp.org</a>
      </div>
    </div>
  </div>

  <div class="mt-8 pt-6 border-t border-black/5 text-center">
    <p class="text-[12px] text-gray-400">&copy; 2026 KenyaNLP</p>
  </div>
</footer>
