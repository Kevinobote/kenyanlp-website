---
const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/team', label: 'Team' },
  { href: '/community', label: 'Community' },
];
---
<nav class="sticky top-0 z-100 bg-[#FAFAF8]/92 backdrop-blur-md border-b border-black/10 px-8 h-16 flex items-center justify-between" aria-label="Main navigation">
  <a href="/" class="flex items-center gap-2.5 no-underline text-gray-900 font-semibold text-[17px] tracking-tight">
    <div class="w-8 h-8 bg-green-600 rounded-lg flex items-center justify-center text-white text-[13px] font-bold tracking-tighter">KN</div>
    KenyaNLP
  </a>

  <ul class="hidden md:flex items-center gap-8 list-none" id="nav-menu">
    {navLinks.map(link => (
      <li><a href={link.href} class="text-gray-600 text-sm hover:text-gray-900 transition-colors no-underline">{link.label}</a></li>
    ))}
    <li><a href="/contact" class="bg-green-600 text-white! px-5 py-2 rounded-full text-[13px] font-medium hover:bg-green-800 transition-colors no-underline">Get Involved</a></li>
  </ul>

  <button class="md:hidden text-xl bg-transparent border-none cursor-pointer text-gray-900" id="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
    ☰
  </button>
</nav>

<!-- Mobile menu -->
<div class="hidden md:hidden fixed inset-0 top-16 z-50 bg-[#FAFAF8]/97 backdrop-blur-md p-8" id="mobile-menu">
  <ul class="flex flex-col gap-6 list-none">
    {navLinks.map(link => (
      <li><a href={link.href} class="text-gray-600 text-lg hover:text-gray-900 transition-colors no-underline">{link.label}</a></li>
    ))}
    <li><a href="/contact" class="bg-green-600 text-white! inline-block px-6 py-3 rounded-full text-sm font-medium hover:bg-green-800 transition-colors no-underline">Get Involved</a></li>
  </ul>
</div>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.textContent = isOpen ? '☰' : '✕';
  });
</script>
