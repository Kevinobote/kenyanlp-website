---
interface Props {
  icon?: string;
  iconBg?: string;
  title: string;
  description: string;
}
const { icon, iconBg = 'bg-green-50', title, description } = Astro.props;
---
<div class="bg-white border border-black/10 rounded-xl p-6">
  {icon && (
    <div class={`w-10 h-10 rounded-[10px] flex items-center justify-center text-lg mb-4 ${iconBg}`}>
      {icon}
    </div>
  )}
  <h3 class="text-base font-semibold mb-2 leading-snug">{title}</h3>
  <p class="text-sm text-gray-600 leading-relaxed">{description}</p>
</div>
